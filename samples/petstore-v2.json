{
  "swagger": "2.0",
  "info": {
    "title": "Petstore (Swagger 2.0)",
    "version": "1.0.0",
    "description": "Ejemplo de especificación Swagger 2.0 en JSON."
  },
  "host": "petstore.ejemplo.com",
  "basePath": "/v1",
  "schemes": ["https"],
  "produces": ["application/json"],
  "paths": {
    "/pets": {
      "get": {
        "summary": "Lista las mascotas",
        "operationId": "listPets",
        "parameters": [
          { "name": "limit", "in": "query", "type": "integer", "format": "int32" }
        ],
        "responses": {
          "200": {
            "description": "Lista de mascotas",
            "schema": { "type": "array", "items": { "$ref": "#/definitions/Pet" } }
          }
        }
      }
    },
    "/pets/{petId}": {
      "get": {
        "summary": "Obtiene una mascota",
        "operationId": "showPetById",
        "parameters": [
          { "name": "petId", "in": "path", "required": true, "type": "string" }
        ],
        "responses": {
          "200": { "description": "La mascota", "schema": { "$ref": "#/definitions/Pet" } },
          "404": { "description": "No encontrada" }
        }
      }
    }
  },
  "definitions": {
    "Pet": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "integer", "format": "int64" },
        "name": { "type": "string" },
        "tag": { "type": "string" }
      }
    }
  }
}
